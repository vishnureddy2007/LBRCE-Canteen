# ==============================================================================
# LBRCE Canteen Management System - Backend Environment Configuration Template
# Set these variables in your hosting environment (e.g., Render, Railway, Docker).
# ==============================================================================

# Database Connection (Hosted MySQL with SSL)
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/lbrce_canteen?useSSL=true&requireSSL=true&sslMode=REQUIRED&connectTimeout=10000&socketTimeout=30000
SPRING_DATASOURCE_USERNAME=YOUR_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# Hibernate DDL Mode: 'validate' in production
JPA_DDL_AUTO=validate

# Production Session Cookie Settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Allowed CORS Origins (Leave blank for single-origin deployment)
APP_CORS_ALLOWED_ORIGINS=

# Initial Administrator Bootstrap (Run once during first deployment; minimum 12 chars password)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@lbrce.ac.in
BOOTSTRAP_ADMIN_PASSWORD=YOUR_STRONG_12_CHAR_PASSWORD
BOOTSTRAP_ADMIN_FULL_NAME=Canteen Administrator

# Cloudinary Storage for Food Images (Optional but recommended for cloud persistence)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Development Demo Seeding (ONLY active when SPRING_PROFILES_ACTIVE=dev)
APP_DEV_SEED_ADMIN_USERNAME=admin
APP_DEV_SEED_ADMIN_PASSWORD=

# ==============================================================================
# LBRCE Canteen Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' if customizing local or external runs.
# ==============================================================================

# Application Port
PORT=8080

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Choose ONE option below)
# ------------------------------------------------------------------------------

# OPTION A: Docker Compose (Default - automatic MySQL container with preloaded data)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lbrce_canteen?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=10000&socketTimeout=30000
SPRING_DATASOURCE_USERNAME=canteen_user
SPRING_DATASOURCE_PASSWORD=canteen_pass

# OPTION B: Local MySQL Server (e.g. XAMPP, WAMP, or local MySQL Service)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/lbrce_canteen?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=10000&socketTimeout=30000
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root123

# OPTION C: TiDB Cloud Serverless (Recommended: Free 25GB, MySQL 8 Compatible, Built-in Web SQL)
# SPRING_DATASOURCE_URL=jdbc:mysql://<GATEWAY_HOST>:4000/lbrce_canteen?useSSL=true&requireSSL=true&sslMode=REQUIRED&serverTimezone=UTC&connectTimeout=10000&socketTimeout=30000
# SPRING_DATASOURCE_USERNAME=<CLUSTER_PREFIX>.root
# SPRING_DATASOURCE_PASSWORD=YOUR_TIDB_PASSWORD

# OPTION D: Other Cloud MySQL (Aiven, Clever Cloud, Railway, AWS RDS)
# SPRING_DATASOURCE_URL=jdbc:mysql://<HOST>:<PORT>/lbrce_canteen?useSSL=true&requireSSL=true&sslMode=REQUIRED&connectTimeout=10000&socketTimeout=30000
# SPRING_DATASOURCE_USERNAME=YOUR_CLOUD_USER
# SPRING_DATASOURCE_PASSWORD=YOUR_CLOUD_PASSWORD

# Hibernate DDL Mode: 'update' for development/external runs, 'validate' for strict production
JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 2. SESSION COOKIE SECURITY
# ------------------------------------------------------------------------------
# Set to 'false' for local HTTP / Docker / LAN testing.
# Set to 'true' only when running behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 3. INITIAL ADMINISTRATOR BOOTSTRAP
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@lbrce.ac.in
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345678
BOOTSTRAP_ADMIN_FULL_NAME=Canteen Administrator

# ------------------------------------------------------------------------------
# 4. CORS & NETWORK ACCESS
# ------------------------------------------------------------------------------
# Leave blank for default (allows localhost, 127.0.0.1, and private LAN IPs).
# Or provide comma-separated origins/tunnels (e.g., https://yourname.ngrok-free.app).
APP_CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 5. CLOUDINARY STORAGE (Optional)
# ------------------------------------------------------------------------------
# Leave blank to use local filesystem storage under 'uploads/'.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

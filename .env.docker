# ==============================================================================
# LBRCE Canteen MS - Docker Environment Configuration
# ==============================================================================

# Application Port
PORT=8080

# Database Connection (Docker MySQL service)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/lbrce_canteen?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectTimeout=10000&socketTimeout=30000
SPRING_DATASOURCE_USERNAME=canteen_user
SPRING_DATASOURCE_PASSWORD=canteen_pass

# Hibernate Mode
JPA_DDL_AUTO=update

# Session Cookies (false for localhost/HTTP testing)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Initial Administrator Bootstrap
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@lbrce.ac.in
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345678
BOOTSTRAP_ADMIN_FULL_NAME=Canteen Administrator

# CORS (Empty allows default localhost & LAN IPs)
APP_CORS_ALLOWED_ORIGINS=

# Cloudinary (Optional - local uploads are saved to container volume if blank)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
